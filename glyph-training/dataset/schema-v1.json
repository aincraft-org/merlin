{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyph-dataset-v1",
  "type": "object",
  "required": ["schema_version", "example_id", "label", "source", "lineage_group", "author_group", "session_group", "split_group", "strokes"],
  "properties": {
    "schema_version": {"const": "glyph-dataset-v1"},
    "example_id": {"type": "string", "minLength": 1},
    "label": {"enum": ["target-ray", "damage", "heal", "push", "cooldown", "self", "target", "physical", "fire", "frost", "arcane", "reject"]},
    "source": {"enum": ["canonical", "synthetic", "player", "reject"]},
    "lineage_group": {"type": "string", "minLength": 1},
    "seed_id": {"type": ["string", "null"], "minLength": 1},
    "author_group": {"type": "string", "minLength": 1},
    "session_group": {"type": "string", "minLength": 1},
    "split_group": {"type": "string", "minLength": 1},
    "consent": {"type": ["boolean", "null"]},
    "strokes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/stroke"}},
    "generation": {"type": ["object", "null"]}
  },
  "$defs": {
    "point": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "minimum": 0, "exclusiveMaximum": 128}, "y": {"type": "number", "minimum": 0, "exclusiveMaximum": 128}}, "additionalProperties": false},
    "stroke": {"type": "object", "required": ["points", "brush_width", "started_at_millis"], "properties": {"points": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/point"}}, "brush_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 32}, "started_at_millis": {"type": "integer"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
